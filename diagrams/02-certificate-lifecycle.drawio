<mxfile host="app.diagrams.net"><diagram name="02 Certificate lifecycle" id="pki1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;IoT VPN: full certificate lifecycle&lt;/b&gt; (Vault PKI -&gt; hub certs -&gt; device certs -&gt; CRL / revoke)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="-10" width="1700" height="30" as="geometry"/></mxCell><mxCell id="c2" value="0. One-time setup: Vault PKI (vault/pki-setup.sh, run by admin)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="1740" height="200" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;pki-setup.sh&lt;/b&gt;&lt;br&gt;admin, VAULT_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="110" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Root CA&lt;/b&gt; (mount pki_root)&lt;br&gt;EC P-384, valid 20 years&lt;br&gt;ideally offline; only signs the intermediate" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="230" height="110" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;Intermediate / Issuing CA&lt;/b&gt; (pki_iot)&lt;br&gt;EC P-256, valid 10 years&lt;br&gt;CSR generated in Vault, signed by Root&lt;br&gt;(sign-intermediate, set-signed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="250" height="110" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;CRL config&lt;/b&gt; (pki_iot)&lt;br&gt;CRL expiry 48h&lt;br&gt;auto_rebuild, grace 12h&lt;br&gt;auto-tidy every 24h&lt;br&gt;CRL URL: /v1/pki_iot/crl (DER)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="810" y="80" width="270" height="110" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Roles&lt;/b&gt;&lt;br&gt;iot-device: client cert, 1 year, CN &amp;lt;id&amp;gt;.iot.example.com&lt;br&gt;vpn-hub: server cert, 5 years, vpn.iot.example.com" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="290" height="110" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;policies hub-provisioner, iot-operator&lt;br&gt;AWS IAM auth: only role iot-hub-lifecycle&lt;br&gt;KV kv/iot-devices = inventory" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1450" y="80" width="290" height="110" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="signs" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="1. Hub certificate: issued per new hub instance, pushed by the Lambda" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1740" height="330" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;TRIGGER&lt;/b&gt;&lt;br&gt;ASG launches a hub: new hub, replacement after failure, AMI update / instance refresh" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="200" height="100" as="geometry"/></mxCell><mxCell id="t2" value="ASG lifecycle hook -&gt; EventBridge -&gt; &lt;b&gt;hub_lifecycle&lt;/b&gt; Lambda" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="280" y="300" width="200" height="100" as="geometry"/></mxCell><mxCell id="t3" value="Lambda attaches a free slot ENI as ether2 (slot design)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="170" height="100" as="geometry"/></mxCell><mxCell id="t4" value="Lambda logs in to Vault with AWS IAM auth, role hub-provisioner (token 15 min)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="730" y="300" width="200" height="100" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;Vault&lt;/b&gt; pki_iot/issue/vpn-hub&lt;br&gt;cert + key + ca_chain&lt;br&gt;CN vpn.iot.example.com, EC P-256, 5 years" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="260" height="100" as="geometry"/></mxCell><mxCell id="t6" value="Lambda uploads over RouterOS REST (HTTPS 443, TLS fingerprint pinned):&lt;br&gt;iot-ca.crt, hub.crt, hub.key, hub.rsc" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="470" height="100" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;Hub&lt;/b&gt;: /import hub.rsc&lt;br&gt;import iot-ca.crt (trusted=yes), hub cert + key&lt;br&gt;crl-download=yes, crl-use=yes, /certificate crl add url=Vault CRL&lt;br&gt;uploaded cert/key files deleted afterwards" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1270" y="440" width="470" height="110" as="geometry"/></mxCell><mxCell id="t8" value="Lambda writes the recent-revoked list to the hub, tags the instance, sends CONTINUE; instance goes InService in NLB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="350" height="110" as="geometry"/></mxCell><mxCell id="t9" value="No rotation: hub cert lives 5 years, a replaced instance gets a new cert. Alarm 60 days before expiry of any cert. Plan a new intermediate under the same root around year 7-8." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="520" height="110" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="issue" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="cert, key, chain" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="REST" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t6" target="t7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t7" target="t8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="2. Device certificate: issued by the operator, installed on the device, validated by the hub" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1740" height="360" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;TRIGGER&lt;/b&gt;&lt;br&gt;operator onboards a device (provisioning host via SSM, encrypted disk)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="200" height="100" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;device-cert.sh&lt;/b&gt;&lt;br&gt;issue &amp;lt;id&amp;gt;&lt;br&gt;bulk devices.csv" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="650" width="210" height="100" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Vault&lt;/b&gt; pki_iot/issue/iot-device&lt;br&gt;CN &amp;lt;id&amp;gt;.iot.example.com&lt;br&gt;EC P-256, 1 year" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="530" y="650" width="250" height="100" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Vault KV&lt;/b&gt; kv/iot-devices/&amp;lt;id&amp;gt;&lt;br&gt;serial, cn, status=active, expires&lt;br&gt;private key is NOT stored" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="250" height="100" as="geometry"/></mxCell><mxCell id="d5" value="out/&amp;lt;id&amp;gt;/: .crt, .key, iot-ca.crt, ipsec-params.txt&lt;br&gt;(+ optional MikroTik / strongSwan templates)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="650" width="300" height="100" as="geometry"/></mxCell><mxCell id="d6" value="Secure transfer (SCP/SSH, local bench) to the device; then delete out/&amp;lt;id&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1450" y="650" width="290" height="100" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;Device&lt;/b&gt; stores the key (TPM if possible)&lt;br&gt;IKEv2 to vpn.iot.example.com:4500&lt;br&gt;IKE ID = CN, presents certificate in IKE_AUTH, verifies the hub with iot-ca" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1450" y="800" width="290" height="130" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;Hub&lt;/b&gt; accepts only if: chain leads to iot-ca, not expired, serial not in CRL, IKE ID = name in certificate (remote-id=auto). Then mode-config gives the pool IP" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1040" y="800" width="370" height="130" as="geometry"/></mxCell><mxCell id="d9" value="&lt;b&gt;Renew&lt;/b&gt; (1 year): renew &amp;lt;id&amp;gt; issues a new pair, the old one works until expiry; after cutover run revoke-serial &amp;lt;old&amp;gt;.&lt;br&gt;&lt;b&gt;CSR variant&lt;/b&gt;: sign &amp;lt;id&amp;gt; &amp;lt;csr&amp;gt; keeps the key on the device" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="470" height="130" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="install" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d6" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="IKE_AUTH" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d7" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="3. CRL: what rebuilds it and how it reaches the hubs" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="1740" height="400" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;TRIGGER A&lt;/b&gt;&lt;br&gt;operator: device-cert.sh revoke &amp;lt;id&amp;gt; (lost, stolen, decommissioned)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="210" height="100" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Vault&lt;/b&gt;: pki_iot/revoke (serial), then read pki_iot/crl/rotate: new CRL is built at once and lists the serial" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="290" y="1030" width="260" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Vault KV&lt;/b&gt; status=revoked, revoked_at" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="590" y="1030" width="170" height="100" as="geometry"/></mxCell><mxCell id="c4" value="aws lambda invoke &lt;b&gt;session_sync&lt;/b&gt; {kill, cn, since}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="800" y="1030" width="200" height="100" as="geometry"/></mxCell><mxCell id="c5" value="For every hub in parallel (RouterOS REST):&lt;br&gt;1. add ID to revoked list (iot-kick-revoked)&lt;br&gt;2. force CRL re-download (readd / import / auto)&lt;br&gt;3. check CRL this-update &amp;gt;= since&lt;br&gt;4. remove active IPsec peer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1040" y="1030" width="330" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Hub&lt;/b&gt; downloads: HTTPS GET https://vault/v1/pki_iot/crl (DER), or imports the PEM pushed by the Lambda" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1410" y="1030" width="330" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;TRIGGER B&lt;/b&gt; (no operator): Vault auto_rebuild runs about 12h before the 48h expiry, so roughly every 36h. Hubs pick it up with normal crl-download. Not fast: expiry hygiene only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="330" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Safety net&lt;/b&gt;: scheduler iot-kick-revoked every 15 s removes peers whose ID is in the revoked list. List kept 72h (longer than CRL 48h); new hubs receive it from hub_lifecycle (SSM /iot/revoked-recent)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="410" y="1200" width="330" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Report&lt;/b&gt;: which hubs have a fresh CRL, warning if not. A hub that is down makes revoke fail with a hint; retry is safe" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="780" y="1200" width="300" height="130" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Result&lt;/b&gt;: the tunnel is cut; the device reconnects and the hub rejects it at IKE_AUTH (serial in CRL). Palo Alto needs no action: the old IP-user mapping expires or is overwritten" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1120" y="1200" width="620" height="130" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="parallel" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c6" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;dashed=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#b85450;dashed=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>