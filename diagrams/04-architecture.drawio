  <diagram id="pki" name="3. PKI">
    <mxGraphModel dx="1720" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- section titles -->
        <mxCell id="c_t1" value="&lt;b&gt;Private CA hierarchy&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_t2" value="&lt;b&gt;What is stored where&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="15" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c_t3" value="&lt;b&gt;Mutual authentication (IKEv2)&lt;/b&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="15" width="400" height="30" as="geometry" />
        </mxCell>
        <!-- hierarchy -->
        <mxCell id="c_root" value="&lt;b&gt;Root CA&lt;/b&gt; (pki_root)&lt;br&gt;self-signed, EC P-384&lt;br&gt;&lt;b&gt;20 years&lt;/b&gt;&lt;br&gt;trust anchor, key stays in Vault (ideally offline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="60" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_int" value="&lt;b&gt;Intermediate CA&lt;/b&gt; (pki_iot)&lt;br&gt;signed by Root, EC P-256&lt;br&gt;&lt;b&gt;10 years&lt;/b&gt;&lt;br&gt;signs all leaf certs, publishes CRL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="220" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_hubc" value="&lt;b&gt;Hub certificate&lt;/b&gt;&lt;br&gt;CN vpn.iot.example.com&lt;br&gt;serverAuth, &lt;b&gt;5 years&lt;/b&gt;&lt;br&gt;role vpn-hub, issued per hub at launch, no rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="390" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_devc" value="&lt;b&gt;Device certificate&lt;/b&gt;&lt;br&gt;CN &amp;lt;id&amp;gt;.&amp;lt;class&amp;gt;.dev.iot.example.com&lt;br&gt;clientAuth, &lt;b&gt;1 year&lt;/b&gt;&lt;br&gt;role iot-&amp;lt;class&amp;gt;, renew yearly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_rule" value="Rule: a certificate can never outlive its issuer&lt;br&gt;Root 20y &amp;gt; Intermediate 10y &amp;gt; Hub 5y &amp;gt; Device 1y&lt;br&gt;Plan: new intermediate under the same root around year 7–8" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="550" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_e1" value="signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_root" target="c_int">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e2" value="signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_int" target="c_hubc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_e3" value="signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_int" target="c_devc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- storage -->
        <mxCell id="c_vault" value="&lt;b&gt;HashiCorp Vault (private CA)&lt;/b&gt;&lt;br&gt;• Root + Intermediate private keys (never leave Vault)&lt;br&gt;• issued certs: serial, CN, expiry (list / revoke)&lt;br&gt;• CRL: /v1/pki_iot/crl&lt;br&gt;• KV inventory kv/iot-devices&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;• hub / device private keys: NOT stored&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_hubs" value="&lt;b&gt;MikroTik CHR hub&lt;/b&gt;&lt;br&gt;• own cert + private key (vpn.iot.example.com)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ proves to devices it is OUR hub&lt;br&gt;• iot-ca.crt (trusted) → verifies device certs&lt;br&gt;• CRL downloaded from Vault → blocks revoked&lt;br&gt;• no client list: trusts the CA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c_devs" value="&lt;b&gt;IoT device&lt;/b&gt;&lt;br&gt;• own cert + private key (&amp;lt;id&amp;gt;.&amp;lt;class&amp;gt;...)&lt;br&gt;&amp;nbsp;&amp;nbsp;→ proves its identity to the hub&lt;br&gt;• iot-ca.crt → verifies the hub certificate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c_s1" value="CRL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_vault" target="c_hubs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c_s2" value="cert + key at launch (Lambda)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_vault" target="c_hubs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="165" />
              <mxPoint x="580" y="272" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c_s3" value="cert + key + CA&lt;br&gt;(device-cert.sh, secure channel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;dashed=1;endArrow=open;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_vault" target="c_devs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="165" />
              <mxPoint x="950" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- sequence: heads -->
        <mxCell id="c_hd" value="&lt;b&gt;IoT device&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_hh" value="&lt;b&gt;MikroTik hub&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="60" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c_ld" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="100" as="sourcePoint" />
            <mxPoint x="1120" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_lh" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1460" y="100" as="sourcePoint" />
            <mxPoint x="1460" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- sequence: messages -->
        <mxCell id="c_m1" value="1. IKE_SA_INIT: algorithms + Diffie-Hellman" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="150" as="sourcePoint" />
            <mxPoint x="1460" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_m1r" value="IKE_SA_INIT response (channel is now encrypted)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1460" y="190" as="sourcePoint" />
            <mxPoint x="1120" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_m2" value="2. IKE_AUTH: device cert + ID + signature" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6C8EBF;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="250" as="sourcePoint" />
            <mxPoint x="1460" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_chk1" value="&lt;b&gt;Hub checks&lt;/b&gt;&lt;br&gt;signed by our CA?&lt;br&gt;not expired?&lt;br&gt;not in CRL?&lt;br&gt;IKE ID == CN?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1480" y="235" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c_m3" value="3. IKE_AUTH: hub cert + signature" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#D79B00;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1460" y="360" as="sourcePoint" />
            <mxPoint x="1120" y="360" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_chk2" value="&lt;b&gt;Device checks&lt;/b&gt;&lt;br&gt;signed by our CA?&lt;br&gt;ID == vpn.iot.example.com?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="960" y="345" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_m4" value="4. virtual IP from hub pool + CHILD SA (ESP tunnel)" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#1A73E8;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;startArrow=block;startFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1120" y="460" as="sourcePoint" />
            <mxPoint x="1460" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c_note" value="Certificates are used only for authentication. Traffic is encrypted with keys negotiated in step 1 and rekeyed regularly.&lt;br&gt;&lt;br&gt;Why hubs need a certificate: authentication is mutual. Without it, a spoofed DNS / IP could impersonate the VPN server (man-in-the-middle) and receive device data." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="960" y="580" width="680" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
