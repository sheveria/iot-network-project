        <mxCell id="b_l1" value="Device certificate issuance (generated centrally)" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;startSize=30;fontSize=12;" vertex="1" parent="1">
