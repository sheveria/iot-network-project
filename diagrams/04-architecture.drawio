          <mxGeometry x="560" y="385" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_pa" value="&lt;b&gt;Palo Alto&lt;/b&gt;&lt;br&gt;user iot\&amp;lt;id&amp;gt; from syslog&lt;br&gt;(logs; one policy for all)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAD9D5;strokeColor=#AE4132;fontSize=11;" vertex="1" parent="1">
