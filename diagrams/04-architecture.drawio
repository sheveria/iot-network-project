          <mxGeometry x="300" y="620" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_rev1" value="&lt;b&gt;Vault&lt;/b&gt; pki_iot/revoke&lt;br&gt;+ crl/rotate → CRL rebuilt now&lt;br&gt;KV status = revoked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_rev2" value="&lt;b&gt;Lambda session_sync&lt;/b&gt; {kill, since}&lt;br&gt;every hub: reload CRL (check this-update),&lt;br&gt;kill live tunnel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="650" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_rev3" value="&lt;b&gt;Safety net&lt;/b&gt;: SSM /iot/revoked-recent (72 h)&lt;br&gt;→ hub scheduler every 15 s kicks&lt;br&gt;if CRL reload failed on a hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="280" height="70" as="geometry" />
        </mxCell>
        <!-- lane 4: hub certs -->
        <mxCell id="b_lc" value="&lt;b&gt;Lambda hub_lifecycle&lt;/b&gt;&lt;br&gt;new hub (ASG hook) only&lt;br&gt;no rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="830" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_hubpki" value="&lt;b&gt;Vault PKI&lt;/b&gt;&lt;br&gt;AWS IAM auth (Lambda role)&lt;br&gt;pki_iot/issue/vpn-hub&lt;br&gt;vpn.iot.example.com, 5 years" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="825" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b_hub2" value="&lt;b&gt;CHR hubs&lt;/b&gt;&lt;br&gt;REST 443: cert + key + iot-ca&lt;br&gt;identity → hub cert&lt;br&gt;renewed by replacing the hub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="830" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_note" value="Access is granted by issuing a certificate and removed by revoking it.&lt;br&gt;Hubs keep no client list: they trust the CA, so new hubs accept all devices immediately." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1200" y="820" width="360" height="100" as="geometry" />
