        <mxCell id="b_op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;provisioning host&lt;br&gt;(EC2 via SSM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_script" value="&lt;b&gt;device-cert.sh&lt;/b&gt;&lt;br&gt;issue &amp;lt;id&amp;gt; &amp;lt;class&amp;gt;&lt;br&gt;bulk devices.csv&lt;br&gt;renew &amp;lt;id&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="75" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_pki" value="&lt;b&gt;Vault PKI&lt;/b&gt;&lt;br&gt;pki_iot/issue/iot-&amp;lt;class&amp;gt;&lt;br&gt;generates EC P-256 key + 1-year cert&lt;br&gt;CN = &amp;lt;id&amp;gt;.&amp;lt;class&amp;gt;.dev.iot.example.com&lt;br&gt;does NOT store the key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b_kv" value="&lt;b&gt;Vault KV&lt;/b&gt; kv/iot-devices/&amp;lt;id&amp;gt;&lt;br&gt;serial, class, cn, status,&lt;br&gt;expires, prev_serial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_out" value="&lt;b&gt;out/&amp;lt;id&amp;gt;/&lt;/b&gt;&lt;br&gt;&amp;lt;id&amp;gt;.crt — certificate&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;&amp;lt;id&amp;gt;.key — private key (SECRET)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;iot-ca.crt — CA chain&lt;br&gt;&amp;lt;id&amp;gt;.ipsec-params.txt — settings for any device&lt;br&gt;&amp;lt;id&amp;gt;.mikrotik.rsc / .strongswan-swanctl.conf — optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="50" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b_dev" value="&lt;b&gt;IoT device&lt;/b&gt;&lt;br&gt;(any IKEv2 client)&lt;br&gt;imports cert + key + CA,&lt;br&gt;IKE ID = CN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1340" y="75" width="190" height="80" as="geometry" />
        </mxCell>
