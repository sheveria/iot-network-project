        <mxCell id="e2b" edge="1" parent="1" source="lb" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" target="hb" value="encrypted tunnel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2c" edge="1" parent="1" source="lb" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="hc">
          <mxGeometry relative="1" x="-0.1086" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="280" />
              <mxPoint x="490" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3a" edge="1" parent="1" source="ha" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="tgw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" edge="1" parent="1" source="hb" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" target="tgw" value="clear traffic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3c" edge="1" parent="1" source="hc" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="tgw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="tgw" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="pa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="pa" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ev" edge="1" parent="1" source="vault" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#9673a6;dashed=1;endArrow=block;" target="hc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="back" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontSize=13;fontColor=#d79b00;fontStyle=1;" value="Commands to a device go the same way back: Platform → Palo Alto → Transit Gateway → the hub that holds this device’s tunnel → device." vertex="1">
          <mxGeometry height="50" width="630" x="810" y="75" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=6;verticalAlign=top;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" value="&lt;b&gt;Five things to say&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; The VPN ends on our own MikroTik hubs, not on the shared Palo Alto.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; One hub per Availability Zone; if one fails the device reconnects to another within about a minute.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Each hub gives devices an address from its own pool, so Palo Alto sees a normal IP traffic and can inspect and log it.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Adding a device needs no change on any hub or firewall: Vault issues a certificate and that is all.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Revoking a device: Vault publishes the new revoke list and the hubs reload it." vertex="1">
          <mxGeometry height="190" width="630" x="100" y="630" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
