  <diagram name="00 Simple overview" id="simple1">
    <mxGraphModel dx="1488" dy="782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;fontSize=18;" value="&lt;b&gt;IoT VPN on AWS: the whole idea in one picture&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="900" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="dev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;1. IoT devices&lt;/b&gt;&lt;br&gt;&lt;br&gt;behind mobile / carrier NAT&lt;br&gt;IPsec IKEv2 + certificate" vertex="1">
          <mxGeometry height="120" width="170" x="250" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;2. Entry point&lt;/b&gt;&lt;br&gt;&lt;br&gt;Global Accelerator&lt;br&gt;+ Network LB&lt;br&gt;UDP 4500/500" vertex="1">
          <mxGeometry height="120" width="170" x="250" y="200" as="geometry" />
        </mxCell>
        <mxCell id="vpc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fillColor=none;strokeColor=#232f3e;strokeWidth=2;dashed=1;" value="AWS VPC (3 Availability Zones)" vertex="1">
          <mxGeometry height="420" width="300" x="470" y="60" as="geometry" />
        </mxCell>
        <mxCell id="ha" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;3. VPN hub, AZ-a&lt;/b&gt;&lt;br&gt;MikroTik router&lt;br&gt;terminates IPsec" vertex="1">
          <mxGeometry height="90" width="240" x="500" y="100" as="geometry" />
        </mxCell>
        <mxCell id="hb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;3. VPN hub, AZ-b&lt;/b&gt;&lt;br&gt;MikroTik router&lt;br&gt;terminates IPsec" vertex="1">
          <mxGeometry height="90" width="240" x="500" y="215" as="geometry" />
        </mxCell>
        <mxCell id="hc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;3. VPN hub, AZ-c&lt;/b&gt;&lt;br&gt;MikroTik router&lt;br&gt;terminates IPsec" vertex="1">
          <mxGeometry height="90" width="240" x="500" y="330" as="geometry" />
        </mxCell>
        <mxCell id="tgw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;4. Transit Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;sends traffic to the firewall" vertex="1">
          <mxGeometry height="120" width="170" x="830" y="200" as="geometry" />
        </mxCell>
        <mxCell id="pa" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;5. Palo Alto&lt;/b&gt;&lt;br&gt;&lt;br&gt;inspects and logs&lt;br&gt;clear (decrypted) traffic" vertex="1">
          <mxGeometry height="120" width="170" x="830" y="420" as="geometry" />
        </mxCell>
        <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;6. Platform&lt;/b&gt;&lt;br&gt;&lt;br&gt;EKS services" vertex="1">
          <mxGeometry height="120" width="170" x="830" y="570" as="geometry" />
        </mxCell>
        <mxCell id="vault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" value="&lt;b&gt;Vault&lt;/b&gt; (private CA)&lt;br&gt;issues device and hub certificates, publishes the revoke list (CRL)" vertex="1">
          <mxGeometry height="70" width="300" x="470" y="520" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="dev" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2a" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=3;strokeColor=#0050ef;endArrow=block;">
          <mxGeometry relative="1" as="geometry">
